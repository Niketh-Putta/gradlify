# Copy to .env for local dev.
# Never commit real secrets.

VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Remote migrations / SQL (Dashboard → Project Settings → Database → password)
SUPABASE_DB_PASSWORD=""
# Optional: https://supabase.com/dashboard/account/tokens (for `supabase db push --linked`)
SUPABASE_ACCESS_TOKEN=""
VITE_DISCORD_INVITE_URL="https://discord.gg/SDxMuVJX"

VITE_TESTING_MODE=false

# Production 11+ app (set on Vercel - required for correct onboarding + landing)
VITE_APP_TRACK=11PLUS
# Optional: force exam readiness UI on 11+ (defaults on when VITE_APP_TRACK=11PLUS)
VITE_EXAM_READINESS_ENABLED=true

# Server-only (do not expose client-side)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Jarvis ADA Gemini Live (video-like voice) - aistudio.google.com/app/apikey
GEMINI_API_KEY=""
OPENAI_API_KEY=""
# Jarvis Wispr voice → Cursor agent (not OpenAI). cursor.com/dashboard/integrations
CURSOR_API_KEY=""
# Autonomous partnership email agent (scripts/gradlify-email-agent.py)
GRADLIFY_EMAIL_MODEL="gpt-4o-mini"
# Hard block third-party sends (default on). Set 0 only if Niketh re-enables outreach autopilot.
GRADLIFY_NO_OUTBOUND_EMAIL="1"
RESEND_API_KEY=""
SUPPORT_EMAIL_FROM="Gradlify <onboarding@resend.dev>"

# Stripe configuration
ENVIRONMENT="development"
STRIPE_SECRET_KEY_TEST=""
STRIPE_SECRET_KEY_LIVE=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET_TEST=""
STRIPE_WEBHOOK_SECRET_LIVE=""
# Stripe Price IDs are immutable - create a new Price in Dashboard/CLI, then point env vars here.
# Base (Premium) weekly for 11+ is STRIPE_PRICE_11PLUS_WEEKLY_* (£9.99/wk as of June 2026).
# Legacy monthly price IDs (STRIPE_PRICE_11PLUS_MONTHLY_*) remain for existing subscribers only.
# Base (Premium) annual for 11+ is STRIPE_PRICE_11PLUS_ANNUAL_* (£249.99/yr as of June 2026).
# Also set STRIPE_PRICE_MONTHLY_* if your app uses stripe-price / shared stripeConfig GCSE keys.
STRIPE_PRICE_MONTHLY_TEST=""
STRIPE_PRICE_MONTHLY_LIVE=""
STRIPE_PRICE_ANNUAL_TEST=""
STRIPE_PRICE_ANNUAL_LIVE=""
STRIPE_PRICE_11PLUS_WEEKLY_TEST=""
STRIPE_PRICE_11PLUS_WEEKLY_LIVE=""
STRIPE_PRICE_11PLUS_MONTHLY_TEST=""
STRIPE_PRICE_11PLUS_ANNUAL_TEST=""
STRIPE_PRICE_11PLUS_MONTHLY_LIVE=""
STRIPE_PRICE_11PLUS_ANNUAL_LIVE=""
# Ultra: £249.99/mo, £2499.99/yr - create new Stripe Prices when changing amounts; do not edit existing Price objects.
STRIPE_PRICE_11PLUS_ULTRA_MONTHLY_TEST=""
STRIPE_PRICE_11PLUS_ULTRA_MONTHLY_LIVE=""
STRIPE_PRICE_11PLUS_ULTRA_ANNUAL_TEST=""
STRIPE_PRICE_11PLUS_ULTRA_ANNUAL_LIVE=""
STRIPE_PRICE_ELEVEN_PLUS_ULTRA_ANNUAL_TEST=""
STRIPE_PRICE_ELEVEN_PLUS_ULTRA_ANNUAL_LIVE=""

# Live mock spot pricing (edge functions; optional overrides)
# LIVE_MOCK_DISCOUNT_DISPLAY_CAP=60
# LIVE_MOCK_DISCOUNT_PRICE_GBP=9.99
# LIVE_MOCK_STANDARD_PRICE_GBP=14.99
# LIVE_MOCK_PRICE_ID_LIVE=price_xxx          # £9.99
# LIVE_MOCK_STANDARD_PRICE_ID_LIVE=price_xxx # £14.99

# Application URLs for success/cancel redirects
# Point this at your local origin when running `npm run dev`; production overrides should be stored elsewhere.
APP_BASE_URL="http://127.0.0.1:5173"

# Protein Tracker (local: npm run dev:lan → http://<LAN-IP>:5173/protein)
# Edge functions: analyze-food-protein (GEMINI_API_KEY), create-protein-checkout (£4.99/mo)
# Founder nikhath13@gmail.com gets unlimited scans via protein_profiles migration seed
